{
	"name": "your-blog",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-24",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/stats/*", "/api/guestbook", "/api/guestbook/*", "/api/links"]
	},
	"d1_databases": [
		{
			"binding": "STATS_DB",
			"database_name": "your-blog-stats",
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
			"migrations_dir": "worker/migrations"
		}
	],
	"ratelimits": [
		{ "name": "STATS_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
		{ "name": "GUESTBOOK_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
		{ "name": "LINKS_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }
	]
}
