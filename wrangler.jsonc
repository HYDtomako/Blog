{
	"name": "blog",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-24",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/stats/*"]
	},
	"d1_databases": [
		{
			"binding": "STATS_DB",
			"database_name": "hydblog-stats",
			"database_id": "5196a108-2876-4fde-81de-f60b2ff6d3ef",
			"migrations_dir": "worker/migrations"
		}
	],
	"ratelimits": [
		{ "name": "STATS_RATE_LIMITER", "namespace_id": "300001", "simple": { "limit": 120, "period": 60 } }
	],
	"routes": [
		{
			"pattern": "hydblog.xyz",
			"custom_domain": true
		}
	]
}
