{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hydblog-twikoo",
	"main": "src/index.js",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	// Text comments only. Image upload stays on Twikoo's default path until an R2 bucket is added.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hydblog-twikoo",
			// Placeholder so `wrangler dev` and local D1 work without a Cloudflare login.
			// Before any real deploy: `npx wrangler d1 create hydblog-twikoo` and paste the id here.
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	]
}
