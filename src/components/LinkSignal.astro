---
import type { PlacedSignal } from '../lib/links';
const { signal, host = false, openLabel } = Astro.props as { signal: PlacedSignal; host?: boolean; openLabel: string };
---
<div class:list={['ls-signal', { 'ls-host': host }]} data-links-signal data-host={host || undefined} data-url={signal.url} data-x={signal.x} data-y={signal.y} data-variant={signal.variant} style={`--ls-x:${signal.x * 100}%;--ls-y:${signal.y * 100}%;--ls-turn:${signal.turn};--ls-i:${signal.index};--ls-scale:${signal.scale}`}>
	<a class="ls-trigger" href={signal.url} target={host ? undefined : '_blank'} rel="noopener noreferrer" aria-label={openLabel} >
		<span class="ls-dot" aria-hidden="true"></span><span class="ls-signal-name">{signal.name}</span>
	</a>
	<div class="ls-card" role="group" aria-label={signal.name}>
		<span class="ls-card-head mono">{signal.signalLabel}</span>
		<span class="ls-card-main"><span class="ls-card-icon"><span class="ls-card-initial">{signal.name.slice(0, 1)}</span>{signal.icon && <img src={signal.icon} alt="" width="30" height="30" referrerpolicy="no-referrer" />}</span><span class="ls-card-text"><span class="ls-card-name">{signal.name}</span><span class="ls-card-desc">{signal.description}</span></span></span>
		<span class="ls-card-foot mono"><span class="ls-card-domain">{signal.domain}</span><span class="ls-card-depth">{host ? '' : `DEPTH ${signal.depthLabel}`}</span></span>
		<a class="ls-card-visit" href={signal.url} target={host ? undefined : '_blank'} rel="noopener noreferrer">{openLabel} ↗</a>
	</div>
</div>
