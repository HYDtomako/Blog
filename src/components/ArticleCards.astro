---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { estimateReadingMinutes, formatArticleDate } from '../lib/articles';
import { collectionTagHref, listSummary, tagSlug, type ListCollection } from '../lib/list-pages';
import { localeFromPath } from '../lib/locale';
import { withBase } from '../lib/paths';
import { getSiteCopy } from '../lib/site-copy';

interface Props {
	entries: CollectionEntry<'docs'>[];
	collection: ListCollection;
}

const { entries, collection } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const UI = getSiteCopy(locale).ui;
---

<ol class="post-list">
	{
		entries.map((entry) => {
			const summary = listSummary(entry.data);
			const tags = entry.data.tags ?? [];
			return (
				<li class="post-card">
					<a class="post-card-main" href={withBase(`/${entry.id}/`)}>
						<time class="post-card-date" datetime={entry.data.pubDate?.toISOString().slice(0, 10)}>
							{formatArticleDate(entry.data.pubDate!)}
						</time>
						<div class="post-card-title">{entry.data.title || entry.id}</div>
						{summary && <p class="post-card-excerpt">{summary}</p>}
						<div class="post-card-read">
							<Icon name="clock" size={14} />
							{UI.common.readingMinutes(estimateReadingMinutes(entry.body?.length ?? 0))}
						</div>
					</a>
					{tags.length > 0 && (
						<div class="post-card-tags">
							{tags.map((tag) => {
								const slug = tagSlug(tag, locale);
								if (!slug) return null;
								return (
									<a class="tag-capsule" href={collectionTagHref(collection, slug, 1, locale)}>
										{tag}
									</a>
								);
							})}
						</div>
					)}
				</li>
			);
		})
	}
</ol>

<style>
	.post-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 18px;
		margin: 0;
		padding: 0;
	}
	.post-card {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 14px;
		padding: 22px 26px 20px;
		border: 1px solid var(--line);
		border-radius: var(--r-lg);
		background: var(--surface);
		transition:
			border-color var(--duration-fast) var(--ease-out-quart),
			background var(--duration-fast) var(--ease-out-quart);
	}
	.post-card:hover,
	.post-card:focus-within {
		border-color: var(--ink);
		background: color-mix(in srgb, var(--ink) 3%, var(--surface));
	}
	.post-card-main {
		display: block;
		min-width: 0;
	}
	.post-card-date {
		font-family: var(--mono);
		font-size: 13px;
		color: var(--faint);
		letter-spacing: 0.04em;
	}
	.post-card-title {
		margin-top: 0.55rem;
		font-family: var(--serif);
		font-size: clamp(1.35rem, 2vw, 1.7rem);
		font-weight: 500;
		line-height: 1.3;
		color: var(--ink);
		text-wrap: balance;
	}
	.post-card-main:hover .post-card-title,
	.post-card-main:focus-visible .post-card-title {
		text-decoration: underline;
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}
	.post-card-excerpt {
		margin: 0.7rem 0 0;
		font-size: 16px;
		line-height: 1.7;
		color: var(--muted);
		text-wrap: pretty;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}
	.post-card-read {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 0.95rem;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--faint);
	}
	.post-card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
	}
	@media (max-width: 640px) {
		.post-card {
			padding: 18px 18px 16px;
		}
		.post-card-title {
			font-size: 1.3rem;
		}
	}
</style>
