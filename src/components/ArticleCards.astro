---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { estimateReadingMinutes, formatArticleDate } from '../lib/articles';
import { listSummary } from '../lib/list-pages';
import { localeFromPath } from '../lib/locale';
import { withBase } from '../lib/paths';
import { getSiteCopy } from '../lib/site-copy';

interface Props {
	entries: CollectionEntry<'docs'>[];
}

const { entries } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const UI = getSiteCopy(locale).ui;
---

<ol class="post-list">
	{
		entries.map((entry) => {
			const summary = listSummary(entry.data);
			const tags = entry.data.tags ?? [];
			return (
				<li>
					<a class="post-card" href={withBase(`/${entry.id}/`)}>
						<div class="post-card-main">
							<time class="post-card-date" datetime={entry.data.pubDate?.toISOString().slice(0, 10)}>
								{formatArticleDate(entry.data.pubDate!)}
							</time>
							<div class="post-card-title">{entry.data.title || entry.id}</div>
							{summary && <p class="post-card-excerpt">{summary}</p>}
							<div class="post-card-read">
								<Icon name="clock" size={14} />
								{UI.common.readingMinutes(estimateReadingMinutes(entry.body?.length ?? 0))}
							</div>
						</div>
						{tags.length > 0 && (
							<div class="post-card-tags">
								{tags.map((tag) => (
									<span class="post-card-tag">{tag}</span>
								))}
							</div>
						)}
					</a>
				</li>
			);
		})
	}
</ol>

<style>
	.post-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 18px;
		max-width: 46rem;
		margin: 3.5rem 0 0;
		padding: 0;
	}
	.post-card {
		display: flex;
		align-items: flex-start;
		gap: 28px;
		padding: 22px 26px 20px;
		border: 1px solid var(--line);
		border-radius: var(--r-lg);
		background: var(--surface);
		transition:
			border-color var(--duration-fast) var(--ease-out-quart),
			background var(--duration-fast) var(--ease-out-quart);
	}
	.post-card:hover,
	.post-card:focus-visible {
		border-color: var(--ink);
		background: color-mix(in srgb, var(--ink) 3%, var(--surface));
	}
	.post-card-main {
		flex: 1 1 auto;
		min-width: 0;
	}
	.post-card-date {
		font-family: var(--mono);
		font-size: 13px;
		color: var(--faint);
		letter-spacing: 0.04em;
	}
	.post-card-title {
		margin-top: 0.55rem;
		font-family: var(--serif);
		font-size: clamp(1.35rem, 2vw, 1.7rem);
		font-weight: 500;
		line-height: 1.3;
		color: var(--ink);
		text-wrap: balance;
	}
	.post-card:hover .post-card-title,
	.post-card:focus-visible .post-card-title {
		text-decoration: underline;
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}
	.post-card-excerpt {
		margin: 0.7rem 0 0;
		font-size: 16px;
		line-height: 1.7;
		color: var(--muted);
		text-wrap: pretty;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}
	.post-card-read {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 0.95rem;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--faint);
	}
	.post-card-tags {
		display: flex;
		flex: 0 0 auto;
		flex-wrap: wrap;
		justify-content: flex-end;
		align-content: flex-start;
		gap: 8px;
		max-width: 16rem;
		margin: 0;
		padding-top: 2px;
	}
	.post-card-tag {
		padding: 2px 10px;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 12px;
		line-height: 1.45;
		color: var(--muted);
		white-space: nowrap;
	}
	@media (max-width: 860px) {
		.post-card {
			flex-direction: column;
			gap: 14px;
			padding: 18px 18px 16px;
		}
		.post-card-tags {
			flex: none;
			width: 100%;
			max-width: none;
			justify-content: flex-start;
			padding-top: 0;
		}
		.post-card-title {
			font-size: 1.3rem;
		}
	}
</style>
