---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { estimateReadingMinutes, formatArticleDate } from '../lib/articles';
import { listSummary } from '../lib/list-pages';
import { localeFromPath } from '../lib/locale';
import { withBase } from '../lib/paths';
import { getSiteCopy } from '../lib/site-copy';

interface Props {
	entries: CollectionEntry<'docs'>[];
}

const { entries } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const UI = getSiteCopy(locale).ui;
---

<ol class="post-list">
	{
		entries.map((entry) => {
			const summary = listSummary(entry.data);
			const tags = entry.data.tags ?? [];
			return (
				<li>
					<a class="post-card" href={withBase(`/${entry.id}/`)}>
						<time class="post-card-date" datetime={entry.data.pubDate?.toISOString().slice(0, 10)}>
							{formatArticleDate(entry.data.pubDate!)}
						</time>
						<div class="post-card-title">{entry.data.title || entry.id}</div>
						{summary && <p class="post-card-excerpt">{summary}</p>}
						<div class="post-card-read">
							<Icon name="clock" size={14} />
							{UI.common.readingMinutes(estimateReadingMinutes(entry.body?.length ?? 0))}
						</div>
						{tags.length > 0 && (
							<div class="post-card-tags">
								{tags.map((tag) => (
									<span class="post-card-tag">{tag}</span>
								))}
							</div>
						)}
					</a>
				</li>
			);
		})
	}
</ol>

<style>
	.post-list {
		list-style: none;
		max-width: 42rem;
		margin: 3.5rem 0 0;
		padding: 0;
	}
	.post-card {
		display: block;
		padding: 2.35rem 0 2.6rem;
		border-top: 1px solid var(--line-soft);
		transition: padding-left var(--duration-mid) var(--ease-out-quart);
	}
	.post-list li:last-child .post-card {
		border-bottom: 1px solid var(--line-soft);
	}
	.post-card:hover,
	.post-card:focus-visible {
		padding-left: 8px;
	}
	.post-card-date {
		font-family: var(--mono);
		font-size: 13px;
		color: var(--faint);
		letter-spacing: 0.04em;
	}
	.post-card-title {
		margin-top: 0.55rem;
		font-family: var(--serif);
		font-size: clamp(1.45rem, 2vw, 1.85rem);
		font-weight: 500;
		line-height: 1.3;
		color: var(--ink);
		text-wrap: balance;
	}
	.post-card:hover .post-card-title,
	.post-card:focus-visible .post-card-title {
		text-decoration: underline;
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}
	.post-card-excerpt {
		margin: 0.8rem 0 0;
		font-size: 16px;
		line-height: 1.75;
		color: var(--muted);
		text-wrap: pretty;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}
	.post-card-read {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 1.05rem;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--faint);
	}
	.post-card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 0.85rem;
	}
	.post-card-tag {
		padding: 2px 10px;
		border: 1px solid var(--line-soft);
		border-radius: 999px;
		font-size: 12px;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.post-card {
			padding: 1.85rem 0 2rem;
		}
		.post-card-title {
			font-size: 1.35rem;
		}
	}
</style>
