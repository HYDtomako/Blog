---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import GuestbookBoard from '../GuestbookBoard.astro';
import { siteConfig } from '../../../site.config.mjs';
import { breadcrumbJsonLd, webPageJsonLd } from '../../lib/public-data';
import { localeFromPath, localizedHref, localizedSitePath } from '../../lib/locale';
import { getSiteCopy } from '../../lib/site-copy';

const locale = localeFromPath(Astro.url.pathname);
const UI = getSiteCopy(locale).ui;
const guestbook = UI.guestbook;
const guestbookEnabled = siteConfig.guestbook?.enabled === true;
const pageLede = guestbookEnabled ? guestbook.lede : guestbook.closed;
const guestbookPath = localizedSitePath(locale, '/guestbook/');
const structuredData = [
	webPageJsonLd({
		path: guestbookPath,
		name: guestbook.heading,
		description: pageLede,
		locale,
	}),
	breadcrumbJsonLd([
		{ name: UI.common.home, path: localizedSitePath(locale, '/') },
		{ name: guestbook.heading, path: guestbookPath },
	]),
];
---

<StarlightPage
  frontmatter={{
    title: guestbook.heading,
    description: pageLede,
    template: 'splash',
    contentType: 'page',
    slug: 'guestbook',
    llmSummary: guestbook.summary,
  }}
>
  {structuredData.map((value) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(value)} />
  ))}
  <div class="wrap page">
    <div class="crumbs"><a href={localizedHref(locale, '/')}>{UI.common.home}</a><span class="sep">/</span><span>{guestbook.heading}</span></div>
    <h1 id="guestbook-heading" class="display page-heading">{guestbook.heading}</h1>
    <p class="lede page-lede">{pageLede}</p>
    {guestbookEnabled && <GuestbookBoard />}
  </div>
</StarlightPage>
