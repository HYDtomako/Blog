---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Icon from '../Icon.astro';
import { absoluteUrl, breadcrumbJsonLd, collectionPageJsonLd, docPath, getAnswers } from '../../lib/public-data';
import { withBase } from '../../lib/paths';
import { localeFromPath, localizedHref, localizedSitePath } from '../../lib/locale';
import { getSiteCopy } from '../../lib/site-copy';

const locale = localeFromPath(Astro.url.pathname);
const copy = getSiteCopy(locale);
const UI = copy.ui;

const answers = await getAnswers(locale);
const answersDescription = UI.answers.indexLede;
const answersPath = localizedSitePath(locale, '/answers/');
const structuredData = [
	collectionPageJsonLd({
		path: answersPath,
		name: UI.answers.label,
		description: answersDescription,
		items: answers.map((entry) => ({ name: entry.data.question!, url: docPath(entry) })),
		locale,
	}),
	breadcrumbJsonLd([
		{ name: UI.answers.homeCrumb, path: localizedSitePath(locale, '/') },
		{ name: UI.answers.label, path: answersPath },
	]),
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		'@id': absoluteUrl(`${answersPath}#faq`),
		mainEntity: answers.map((entry) => ({
			'@type': 'Question',
			name: entry.data.question,
			acceptedAnswer: { '@type': 'Answer', text: entry.data.shortAnswer },
		})),
	},
];
---

<StarlightPage
	frontmatter={{
		title: UI.answers.label,
		description: answersDescription,
		template: 'splash',
		contentType: 'page',
		slug: 'answers',
		llmSummary: UI.answers.indexLede,
	}}
>
	{structuredData.map((value) => (
		<script is:inline type="application/ld+json" set:html={JSON.stringify(value)} />
	))}
	<div class="wrap page">
		<div class="crumbs"><a href={localizedHref(locale, '/')}>{UI.answers.homeCrumb}</a><span class="sep">/</span><span>{UI.answers.label}</span></div>
		<h1 id="_top" class="display page-heading">{UI.answers.label}</h1>
		<p class="lede page-lede">{UI.answers.indexLede}</p>

		<div class="faq-list answers-index">
			{answers.map((entry) => (
				<a class="answer-index-item" href={withBase(`/${entry.id}/`)}>
					<span class="answer-index-q">{entry.data.question}</span>
					<span class="answer-index-a">{entry.data.shortAnswer}</span>
					<span class="answer-index-arrow" aria-hidden="true">
						<Icon name="arrow-right" size={15} />
					</span>
				</a>
			))}
		</div>

		<div class="article-return">
			<a class="btn btn-solid" href={localizedHref(locale, '/ask/')}>
				<Icon name="spark" size={15} />
				{UI.answers.askCta}
			</a>
		</div>
	</div>
</StarlightPage>
