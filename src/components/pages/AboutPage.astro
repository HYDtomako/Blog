---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import Icon from '../Icon.astro';
import ScrollWaterBall from '../ScrollWaterBall.astro';
import { absoluteUrl, breadcrumbJsonLd, entryLocale, getPublicProfile, personJsonLd } from '../../lib/public-data';
import { withBase } from '../../lib/paths';
import { DEFAULT_LOCALE, localeFromPath, localizedHref, localizedSitePath } from '../../lib/locale';
import { getSiteCopy } from '../../lib/site-copy';
import { copyValueFromContact } from '../../scripts/copy-text';
import { siteConfig } from '../../../site.config.mjs';

const locale = localeFromPath(Astro.url.pathname);
const copy = getSiteCopy(locale);
const UI = copy.ui;

const profile = await getCollection('profile');
const resumeEntries = await getCollection('resume');
const personEntry =
  profile.find((entry) => entryLocale(entry.id) === locale && entry.data.kind === 'person') ??
  profile.find((entry) => entry.data.kind === 'person');
const resume =
  resumeEntries.find((entry) => entryLocale(entry.id) === locale) ??
  resumeEntries.find((entry) => entryLocale(entry.id) === DEFAULT_LOCALE);

if (!personEntry || personEntry.data.kind !== 'person' || !resume) {
  throw new Error('About page requires person profile and resume content');
}
const contentLocale = entryLocale(personEntry.id);
const person = personEntry.data;
const publicProfile = await getPublicProfile(contentLocale);
const aboutCopy = copy.brand.about;
const { Content } = await render(resume);
const aboutPath = localizedSitePath(locale, '/about/');
const sidebarEmail = copyValueFromContact(person.links?.email);
const contactEmail = copyValueFromContact(siteConfig.contact?.email);
const contactAt = contactEmail ? UI.about.contactLede.indexOf(contactEmail) : -1;
const contactBefore = contactAt >= 0 ? UI.about.contactLede.slice(0, contactAt) : UI.about.contactLede;
const contactAfter = contactAt >= 0 ? UI.about.contactLede.slice(contactAt + contactEmail.length) : '';
const qqNumber = (person.qq ?? '').trim();
const aboutStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd(publicProfile),
    {
      '@type': 'ProfilePage',
      '@id': absoluteUrl(`${aboutPath}#profile`),
      url: absoluteUrl(aboutPath),
      name: aboutCopy.pageName,
      description: resume.data.description,
      inLanguage: locale,
      mainEntity: { '@id': publicProfile.id },
      isPartOf: { '@id': absoluteUrl(`${localizedSitePath(locale, '/')}#website`) },
    },
    breadcrumbJsonLd([
      { name: UI.common.home, path: localizedSitePath(locale, '/') },
      { name: aboutCopy.crumb, path: aboutPath },
    ]),
  ],
};

---

<StarlightPage
  frontmatter={{
    ...resume.data,
    template: 'splash'
  }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aboutStructuredData)} />

  <div class="wrap page about-page">
    <div class="crumbs"><a href={localizedHref(locale, '/')}>{UI.common.home}</a><span class="sep">/</span><span>{aboutCopy.crumb}</span></div>
    <div class="about-grid">
      <aside class="about-aside" aria-label={UI.about.profileAria}>
        <img
          class="portrait about-avatar"
          src={withBase('/asset/avatar.jpg')}
          alt={person.name}
          width="112"
          height="112"
          decoding="async"
        />
        <div class="about-identity">
          <h1 id="_top" class="display about-name">{person.name}</h1>
        </div>
        <nav class="about-links" aria-label={UI.about.linksAria}>
          {person.links?.github && (
            <a class="about-link" href={person.links.github} target="_blank" rel="noreferrer">
              <Icon name="external" size={16} />
              GitHub
            </a>
          )}
          {sidebarEmail && (
            <button
              class="about-link"
              type="button"
              data-copy-text={sidebarEmail}
              data-copied-label={UI.about.copied}
              data-copy-failed-label={UI.about.copyFailed}
              aria-label={UI.about.copyEmail(sidebarEmail)}
            >
              <Icon name="mail" size={16} />
              <span data-copy-label>{sidebarEmail}</span>
              <span class="visually-hidden" data-copy-live aria-live="polite"></span>
            </button>
          )}
          {qqNumber && (
            <button
              class="about-link"
              type="button"
              data-copy-text={qqNumber}
              data-copied-label={UI.about.copied}
              data-copy-failed-label={UI.about.copyFailed}
              aria-label={UI.about.copyQq(qqNumber)}
            >
              <Icon name="message" size={16} />
              <span data-copy-label>{UI.about.qq(qqNumber)}</span>
              <span class="visually-hidden" data-copy-live aria-live="polite"></span>
            </button>
          )}
          <a class="about-link" href={localizedHref(locale, '/projects/')}>
            <Icon name="grid" size={16} />
            {UI.about.allProjects}
          </a>
        </nav>
      </aside>

      <div class="about-main">
        <div class="about-markdown">
          <Content />
          {contactEmail && (
            <>
              <h2 id="about-contact">{UI.about.contactHeading}</h2>
              <p>
                {contactBefore}
                {contactAt >= 0 && (
                  <button
                    class="about-inline-copy"
                    type="button"
                    data-copy-text={contactEmail}
                    data-copied-label={UI.about.copied}
                    data-copy-failed-label={UI.about.copyFailed}
                    aria-label={UI.about.copyEmail(contactEmail)}
                  >
                    <span data-copy-label>{contactEmail}</span>
                    <span class="visually-hidden" data-copy-live aria-live="polite"></span>
                  </button>
                )}
                {contactAfter}
              </p>
            </>
          )}
        </div>

        <section class="cooperation-panel" aria-labelledby="about-cooperation">
          <h2 id="about-cooperation" class="section-title cooperation-title">
            {publicProfile.cooperation?.title ?? UI.about.cooperationFallback}
          </h2>
          <p class="cooperation-description">{publicProfile.cooperation?.description}</p>
          <div class="cooperation-actions">
            {sidebarEmail && (
              <button
                class="btn btn-solid"
                type="button"
                data-copy-text={sidebarEmail}
                data-copied-label={UI.about.copied}
                data-copy-failed-label={UI.about.copyFailed}
                aria-label={UI.about.copyEmail(sidebarEmail)}
              >
                <Icon name="mail" size={15} />
                <span data-copy-label>{UI.about.sendEmail}</span>
                <span class="visually-hidden" data-copy-live aria-live="polite"></span>
              </button>
            )}
            <button class="btn btn-ghost" type="button" data-open-ask data-query={UI.about.askCollaborate(copy.brand.persona)}>{UI.about.askCollaborateButton}</button>
          </div>
        </section>
      </div>
    </div>
  </div>
  {siteConfig.readingProgress?.enabled && <ScrollWaterBall />}
</StarlightPage>

<script>
  import { initCopyButtons } from '../../scripts/copy-text';

  initCopyButtons(document);
</script>

<style>
  button.about-link {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--line-soft);
    border-radius: 0;
    background: transparent;
    text-align: left;
    font: inherit;
    color: var(--muted);
  }
  button.about-link[data-copied='true'] {
    color: var(--ink);
  }
  button.about-inline-copy {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    font: inherit;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-soft);
    text-underline-offset: 4px;
  }
  button.about-inline-copy:hover,
  button.about-inline-copy:focus-visible {
    text-decoration-color: var(--ink);
  }
</style>
