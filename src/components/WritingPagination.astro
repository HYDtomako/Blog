---
import { getSiteCopy } from '../lib/site-copy';
import { collectionPageHref, paginationControls, type ListCollection } from '../lib/list-pages';
import { localeFromPath } from '../lib/locale';

interface Props {
	collection: ListCollection;
	pageNumber: number;
	pageCount: number;
}

const { collection, pageNumber, pageCount } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const UI = getSiteCopy(locale).ui;
const controls = paginationControls(pageNumber, pageCount);
const pageCrumb = collection === 'notes' ? UI.notes.pageCrumb : UI.writing.pageCrumb;
const ariaLabel = collection === 'notes' ? UI.notes.paginationAria : UI.common.paginationAria;
const href = (page: number) => collectionPageHref(collection, page, locale);
---

{
	controls.visible && (
		<nav aria-label={ariaLabel} class="list-pagination">
			{controls.showPrevious && (
				<a class="list-pagination-nav" href={href(pageNumber - 1)} rel="prev">
					{UI.common.prevPage}
				</a>
			)}
			{controls.pages.map((n) =>
				n === pageNumber ? (
					<span class="list-pagination-current" aria-current="page" aria-label={pageCrumb(n)}>
						{n}
					</span>
				) : (
					<a class="list-pagination-link" href={href(n)} aria-label={pageCrumb(n)}>
						{n}
					</a>
				),
			)}
			{controls.showNext && (
				<a class="list-pagination-nav" href={href(pageNumber + 1)} rel="next">
					{UI.common.nextPage}
				</a>
			)}
		</nav>
	)
}
