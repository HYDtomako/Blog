---
import Icon from './Icon.astro';
import { getSiteCopy } from '../lib/site-copy';
import { localeFromPath, localePrefix, localizedHref } from '../lib/locale';

const locale = localeFromPath(Astro.url.pathname);
const copy = getSiteCopy(locale);
const UI = copy.ui;

/** Without a configured remote Ask endpoint the overlay must not promise a live answer. */
const liveAsk = Boolean(import.meta.env.PUBLIC_ASK_URL);
const askSearchLabels = JSON.stringify(
	liveAsk ? UI.askSearch : { ...UI.askSearch, aiFallback: UI.askSearch.aiFallbackSearch },
);
const askIndexHref = localizedHref(locale, '/api/search-index.json');
const askOverlayNote = UI.answers.label;
---

<dialog
	id="ask-overlay"
	class="overlay"
	aria-labelledby="ask-title"
	data-ask-search-labels={askSearchLabels}
	data-ask-index-href={askIndexHref}
	data-ask-prefix={localePrefix(locale)}
>
	<div class="overlay-panel">
		<h2 id="ask-title" class="visually-hidden">{UI.ask.overlayHeading}</h2>
		<div class="overlay-search">
			<Icon name="spark" size={20} />
			<label class="visually-hidden" for="ask-input">{UI.ask.overlayHeading}</label>
			<input id="ask-input" placeholder={copy.ask.overlayPlaceholder} autocomplete="off" />
			<button class="dialog-close" type="button" data-close-ask aria-label={UI.ask.closeAria}>
				<Icon name="close" size={18} />
			</button>
		</div>
		<div id="ask-results" class="overlay-results" aria-live="polite"></div>
		<div class="overlay-foot">
			<span class="agent-note"><Icon name="spark" size={12} /> {askOverlayNote}</span>
			<span><span class="kbd">Esc</span> {UI.common.close} · <a href={localizedHref(locale, '/ask/')}>{UI.ask.pageTitle}</a></span>
		</div>
	</div>
</dialog>

<script>
	import { createAskSearch, type AskSearchLabels } from '../scripts/ask-search';

	const dialog = document.getElementById('ask-overlay');
	const input = document.getElementById('ask-input');
	const results = document.getElementById('ask-results');

	if (!(input instanceof HTMLInputElement) || !(results instanceof HTMLElement)) {
		throw new Error('Ask overlay markup is missing required elements');
	}

	const raw = dialog instanceof HTMLElement ? dialog.dataset.askSearchLabels : undefined;
	const labels = raw ? (JSON.parse(raw) as AskSearchLabels) : undefined;

	const search = createAskSearch(input, results, {
		showAskFallback: true,
		labels,
		indexHref: dialog instanceof HTMLElement ? dialog.dataset.askIndexHref || undefined : undefined,
		askPrefix: dialog instanceof HTMLElement ? dialog.dataset.askPrefix || '' : '',
	});

	const openAsk = async (query = '') => {
		if (!(dialog instanceof HTMLDialogElement)) return;
		search.setQuery(query);
		if (!dialog.open) dialog.showModal();
		input.focus();
		await search.loadSearchData(true);
		search.renderResults(input.value);
	};

	document.querySelectorAll<HTMLElement>('[data-open-ask]').forEach((trigger) => {
		trigger.addEventListener('click', () => openAsk(trigger.dataset.query ?? ''));
	});
	document.querySelectorAll<HTMLFormElement>('[data-ask-form]').forEach((form) => {
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const field = form.querySelector<HTMLInputElement>('input[name="query"]');
			openAsk(field?.value ?? '');
		});
	});
	document.querySelectorAll<HTMLElement>('[data-close-ask]').forEach((button) => {
		button.addEventListener('click', () => dialog instanceof HTMLDialogElement && dialog.close());
	});
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
	});
	dialog?.addEventListener('close', () => {
		input.value = '';
		search.invalidate();
	});
	window.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase() === 'k') {
			event.preventDefault();
			if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
			else openAsk();
		}
	});
</script>
