---
import { getGitHubActivity } from '../lib/github-activity';
import {
	buildContributionCalendar,
	formatActivityDate,
} from '../lib/github-activity-calendar';
import { localeFromPath } from '../lib/locale';
import { getSiteCopy } from '../lib/site-copy';

const locale = localeFromPath(Astro.url.pathname);
const UI = getSiteCopy(locale).ui;
const activity = await getGitHubActivity();
const calendar = activity ? buildContributionCalendar(activity.days, locale) : null;
const firstInteractive = calendar?.cells.findIndex((cell) => cell) ?? -1;
const owner = activity?.owner ?? '';
const profile = owner ? `https://github.com/${encodeURIComponent(owner)}` : '';
---

{
	activity && calendar && (
		<section class="gh-activity" aria-labelledby="github-activity-heading">
			<div class="section-head section-head-large projects-section-head">
				<div>
					<p class="eyebrow">GitHub</p>
					<h2 id="github-activity-heading" class="section-title">
						{UI.projects.activityHeading}
					</h2>
				</div>
			</div>
			<figure class="gh-figure" data-gh-activity>
				<div class="gh-card" data-gh-card>
					<div class="gh-scroll">
						<div class="gh-plot" style={`--gh-weeks:${calendar.weekCount}`}>
							<div class="gh-months" aria-hidden="true">
								{calendar.monthLabels.map((label) => (
									<span>{label}</span>
								))}
							</div>
							<div class="gh-cells" data-gh-cells>
								<div
									class="gh-layer gh-layer-base"
									data-gh-base
									role="group"
									aria-label={UI.projects.activityAria}
									aria-describedby="gh-activity-keys"
								>
									{calendar.cells.map((day, index) =>
										day ? (
											<button
												type="button"
												class="gh-cell"
												data-level={day.level}
												data-date={day.date}
												data-count={day.count}
												data-noun={UI.projects.activityNoun(day.count)}
												data-date-label={formatActivityDate(day.date, locale)}
												data-index={index}
												aria-label={UI.projects.activityDayAria(
													formatActivityDate(day.date, locale),
													day.count,
												)}
												tabindex={index === firstInteractive ? 0 : -1}
											/>
										) : (
											<span class="gh-cell gh-cell-pad" data-index={index} aria-hidden="true" />
										),
									)}
								</div>
								<div class="gh-layer gh-layer-bright" aria-hidden="true">
									{calendar.cells.map((day) => (
										<span
											class={day ? 'gh-cell' : 'gh-cell gh-cell-pad'}
											data-level={day ? day.level : undefined}
										/>
									))}
								</div>
							</div>
						</div>
					</div>
					<p id="gh-activity-keys" class="visually-hidden">{UI.projects.activityKeys}</p>
					<div class="gh-identity">
						<span class="gh-avatar-wrap">
							<img
								class="gh-avatar"
								data-gh-avatar
								src={`${profile}.png?size=80`}
								alt={UI.projects.activityAvatarAlt(owner)}
								width="36"
								height="36"
								loading="lazy"
								decoding="async"
							/>
							<span class="gh-avatar-fallback" data-gh-avatar-fallback aria-hidden="true">
								{owner.slice(0, 1).toUpperCase()}
							</span>
						</span>
						<span class="gh-identity-copy">
							<span class="gh-user">{owner}</span>
							<span class="gh-total">{UI.projects.activityTotal(activity.total)}</span>
						</span>
						<a
							class="gh-handle"
							href={profile}
							target="_blank"
							rel="noreferrer"
							aria-label={UI.projects.activityProfileAria(owner)}
						>
							@{owner}
						</a>
					</div>
					<p class="mono gh-synced">{UI.projects.activitySynced(activity.syncedAt)}</p>
				</div>
				<div class="gh-tooltip" data-gh-tooltip role="tooltip" aria-hidden="true">
					<span class="gh-tooltip-row">
						<span class="gh-odo" data-gh-odo aria-hidden="true">
							{Array.from({ length: 4 }, () => (
								<span class="gh-odo-col" data-gh-odo-col>
									<span class="gh-odo-spacer" aria-hidden="true">0</span>
									<span class="gh-odo-reel" data-gh-odo-reel>
										{Array.from({ length: 10 }, (_, digit) => (
											<span class="gh-odo-digit">{digit}</span>
										))}
									</span>
								</span>
							))}
						</span>
						<span class="gh-tooltip-noun" data-gh-noun></span>
					</span>
					<span class="gh-tooltip-date" data-gh-date></span>
				</div>
			</figure>
		</section>
	)
}

<script>
	import { initGitHubActivity } from '../scripts/github-activity-panel';

	initGitHubActivity();
</script>

<style>
	.gh-figure {
		position: relative;
		margin: 0;
	}
	.gh-card {
		--gh-gap: 3px;
		--gh-spotlight: 110px;
		/* Cobalt steps from the site canvas (#d5e6fb) and focus blue (#005fcc).
		   Empty stays gray; each step gets deeper. Not the GitHub green ramp. */
		--gh-0: #e8ebf0;
		--gh-1: #c9daf8;
		--gh-2: #8eb4ef;
		--gh-3: #3d7fe0;
		--gh-4: #0c4a9e;
		--gh-b0: #d8dee6;
		--gh-b1: #a9caf8;
		--gh-b2: #5b97f0;
		--gh-b3: #1d66d4;
		--gh-b4: #08357a;
		--gh-glow: rgba(0, 95, 204, 0.42);
		padding: 18px 20px 14px;
		border: 1px solid var(--line);
		border-radius: 16px;
		background: var(--surface);
		box-shadow: var(--shadow);
	}
	:global([data-theme='dark']) .gh-card {
		--gh-0: #2a303b;
		--gh-1: #1e4c86;
		--gh-2: #2a6ec4;
		--gh-3: #5b9af0;
		--gh-4: #d5e6fb;
		--gh-b0: #3e4654;
		--gh-b1: #3a74bc;
		--gh-b2: #5aa0f2;
		--gh-b3: #9ec6fb;
		--gh-b4: #f4f8ff;
		--gh-glow: rgba(213, 230, 251, 0.45);
	}
	.gh-scroll {
		overflow-x: auto;
		padding: 4px 2px 2px;
		margin: -4px -2px 0;
	}
	.gh-plot {
		width: max(100%, calc(var(--gh-weeks) * 11px));
	}
	.gh-months {
		display: grid;
		grid-template-columns: repeat(var(--gh-weeks), minmax(0, 1fr));
		column-gap: var(--gh-gap);
		margin-bottom: 6px;
		font-size: 12px;
		line-height: 1;
		color: var(--faint);
		user-select: none;
	}
	.gh-months span {
		white-space: nowrap;
	}
	.gh-cells {
		position: relative;
		width: 100%;
		aspect-ratio: var(--gh-weeks) / 7;
		--mx: -200px;
		--my: -200px;
		isolation: isolate;
	}
	.gh-layer {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-rows: repeat(7, minmax(0, 1fr));
		grid-template-columns: repeat(var(--gh-weeks), minmax(0, 1fr));
		grid-auto-flow: column;
		gap: var(--gh-gap);
	}
	.gh-layer-bright {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
		-webkit-mask-image: radial-gradient(
			circle var(--gh-spotlight) at var(--mx) var(--my),
			#000 0%,
			rgba(0, 0, 0, 0.55) 38%,
			transparent 76%
		);
		mask-image: radial-gradient(
			circle var(--gh-spotlight) at var(--mx) var(--my),
			#000 0%,
			rgba(0, 0, 0, 0.55) 38%,
			transparent 76%
		);
	}
	.gh-cells:hover .gh-layer-bright,
	.gh-cells:focus-within .gh-layer-bright {
		opacity: 1;
	}
	.gh-cell {
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		padding: 0;
		border: 0;
		appearance: none;
		font: inherit;
		border-radius: 2px;
		background: var(--gh-0);
		transition: transform 0.18s ease;
	}
	.gh-cell-pad {
		visibility: hidden;
		background: transparent !important;
		box-shadow: none !important;
		pointer-events: none;
	}
	.gh-layer-base .gh-cell[data-level='1'] {
		background: var(--gh-1);
	}
	.gh-layer-base .gh-cell[data-level='2'] {
		background: var(--gh-2);
	}
	.gh-layer-base .gh-cell[data-level='3'] {
		background: var(--gh-3);
	}
	.gh-layer-base .gh-cell[data-level='4'] {
		background: var(--gh-4);
	}
	.gh-layer-bright .gh-cell {
		background: var(--gh-b0);
	}
	.gh-layer-bright .gh-cell[data-level='1'] {
		background: var(--gh-b1);
	}
	.gh-layer-bright .gh-cell[data-level='2'] {
		background: var(--gh-b2);
	}
	.gh-layer-bright .gh-cell[data-level='3'] {
		background: var(--gh-b3);
	}
	.gh-layer-bright .gh-cell[data-level='4'] {
		background: var(--gh-b4);
		box-shadow: 0 0 8px var(--gh-glow);
	}
	.gh-layer-base .gh-cell[data-active='true'] {
		position: relative;
		z-index: 2;
		transform: scale(1.35);
	}
	.gh-identity {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: 16px;
	}
	.gh-avatar-wrap {
		position: relative;
		flex: none;
		width: 36px;
		height: 36px;
	}
	.gh-avatar,
	.gh-avatar-fallback {
		width: 36px;
		height: 36px;
		border: 1px solid var(--line);
		border-radius: 50%;
	}
	.gh-avatar {
		object-fit: cover;
	}
	.gh-avatar-fallback {
		display: none;
		align-items: center;
		justify-content: center;
		background: color-mix(in srgb, var(--focus) 14%, var(--surface));
		color: var(--ink);
		font-size: 14px;
		font-weight: 600;
	}
	.gh-avatar-fallback[data-shown='true'] {
		display: flex;
	}
	.gh-identity-copy {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.25;
	}
	.gh-user {
		color: var(--ink);
		font-size: 14px;
		font-weight: 600;
	}
	.gh-total {
		color: var(--muted);
		font-size: 12px;
	}
	.gh-handle {
		margin-left: auto;
		color: var(--faint);
		font-size: 12px;
		transition: color var(--duration-fast) var(--ease-out-quart);
	}
	.gh-handle:hover {
		color: var(--ink);
	}
	.gh-synced {
		margin: 12px 0 0;
		color: var(--faint);
		font-size: 11px;
	}
	.gh-tooltip {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 30;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
		padding: 6px 10px;
		border-radius: 8px;
		background: color-mix(in srgb, var(--ink) 94%, transparent);
		color: var(--bg);
		font-size: 12px;
		font-weight: 600;
		line-height: 1.2;
		white-space: nowrap;
		pointer-events: none;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
		opacity: 0;
		transform: translate(-9999px, -9999px);
		transition: opacity 0.15s ease;
	}
	.gh-tooltip[data-visible='true'] {
		opacity: 1;
	}
	.gh-tooltip-row {
		display: inline-flex;
		align-items: baseline;
		gap: 4px;
	}
	.gh-tooltip-noun {
		font-weight: 500;
		opacity: 0.88;
	}
	.gh-tooltip-date {
		font-size: 11px;
		font-weight: 600;
		line-height: 1;
		opacity: 0.85;
	}
	.gh-odo {
		display: inline-flex;
		height: 1em;
		overflow: hidden;
		font-variant-numeric: tabular-nums;
		font-weight: 600;
		line-height: 1;
	}
	.gh-odo-col {
		position: relative;
		display: inline-block;
		flex: 0 0 0.62em;
		height: 1em;
		min-width: 0;
		overflow: hidden;
		text-align: center;
		transition:
			opacity 0.18s ease,
			flex-basis 0.18s ease;
	}
	.gh-odo-col[data-hidden='true'] {
		flex-basis: 0;
		width: 0;
		min-width: 0;
		opacity: 0;
	}
	.gh-odo-spacer {
		visibility: hidden;
	}
	.gh-odo-reel {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		transition: transform 0.9s var(--ease-out-expo);
	}
	.gh-odo-digit {
		display: block;
		height: 1em;
		line-height: 1;
		text-align: center;
	}
	@media (max-width: 640px) {
		.gh-card {
			--gh-gap: 2px;
			--gh-spotlight: 70px;
			padding: 14px 12px 12px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.gh-cell,
		.gh-odo-reel,
		.gh-odo-col,
		.gh-layer-bright,
		.gh-tooltip,
		.gh-handle {
			transition: none;
		}
		.gh-layer-base .gh-cell[data-active='true'] {
			transform: none;
		}
	}
</style>
