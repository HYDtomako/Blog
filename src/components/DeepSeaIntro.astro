---
import { getSiteCopy } from '../lib/site-copy';

interface Props {
	locale: string;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);

const letters = ['H', 'Y', 'D'];

interface HudRow {
	label: string;
	value: string;
	/** Optional hook: the driver writes the live value into `[data-ds-hud="<hook>"]`. */
	hook?: string;
}

interface HudGauge {
	tone: string;
	rows: HudRow[];
}

/** Corner readouts, kept faint so they never compete with the depth readout. */
const gauges: HudGauge[] = [
	{ tone: 'tl', rows: [{ label: 'DEVICE', value: 'HYD-DSV-01' }] },
	{ tone: 'tr', rows: [{ label: 'RATE', value: '0.0 m/s', hook: 'rate' }] },
	{ tone: 'bl', rows: [
		{ label: 'LAT', value: '12.4° N' },
		{ label: 'LONG', value: '143.2° E' },
	] },
	{ tone: 'br', rows: [{ label: 'SYSTEM', value: 'BOOT', hook: 'system' }] },
];

/** The status line under the readout, one word at a time. */
const statuses = [
	{ key: 'initialized', text: 'SYSTEM INITIALIZED' },
	{ key: 'descending', text: 'DESCENDING' },
	{ key: 'pressure', text: 'PRESSURE RISING' },
	{ key: 'deep-sea', text: 'DEEP WATER' },
	{ key: 'reached', text: 'DEPTH REACHED' },
];

/** The depth ruler that scrolls past as the craft descends. */
const rulerTicks = Array.from({ length: 60 }, (_, index) => ({
	index,
	major: index % 5 === 0,
	label: index % 5 === 0 ? String(11000 - index * 200) : '',
}));
---

<div
	class="deep-intro"
	data-deep-intro
	data-ds-phase="boot"
	data-ds-label="initialized"
	aria-hidden="true"
	inert
>
	<canvas class="ds-snow" data-ds-snow aria-hidden="true"></canvas>

	<div class="ds-stage" aria-hidden="true">
		<div class="ds-bg ds-bg--deep"></div>
		<div class="ds-bg ds-bg--mid"></div>
		<div class="ds-bg ds-bg--shallow"></div>

		<div class="ds-rays">
			<span class="ds-ray ds-ray--a"></span>
			<span class="ds-ray ds-ray--b"></span>
			<span class="ds-ray ds-ray--c"></span>
		</div>

		<div class="ds-caustics">
			<span class="ds-caustic ds-caustic--a"></span>
			<span class="ds-caustic ds-caustic--b"></span>
			<span class="ds-caustic ds-caustic--c"></span>
		</div>

		<svg class="ds-silhouette ds-school" viewBox="0 0 260 150" aria-hidden="true">
			<defs>
				<g id="ds-fish">
					<path d="M3 -3 L-9 -10.5 L-4.5 0 L-9 10.5 L3 3 Z" />
					<path d="M3 0 C6 -9 20 -12 30 -9.5 C38 -7.6 44 -3.5 47 0 C44 3.5 38 7.6 30 9.5 C20 12 6 9 3 0 Z" />
					<path d="M18 -5 C14 -15.5 26 -16 29 -5 Z" />
					<path d="M17 5 C13.5 15 24 15.5 27 5 Z" />
				</g>
			</defs>
			<use href="#ds-fish" transform="translate(24 40) scale(1.1)" />
			<use href="#ds-fish" transform="translate(72 74) scale(0.8) rotate(-4)" />
			<use href="#ds-fish" transform="translate(116 32) scale(0.95) rotate(3)" />
			<use href="#ds-fish" transform="translate(158 92) scale(1.05) rotate(-2)" />
			<use href="#ds-fish" transform="translate(202 58) scale(0.75) rotate(4)" />
		</svg>

		<svg class="ds-silhouette ds-school ds-school--sunlit" viewBox="0 0 260 150" aria-hidden="true">
			<use href="#ds-fish" transform="translate(30 56) scale(1.5) rotate(-3)" />
			<use href="#ds-fish" transform="translate(92 92) scale(1.15) rotate(3)" />
			<use href="#ds-fish" transform="translate(150 44) scale(1.35) rotate(-2)" />
			<use href="#ds-fish" transform="translate(206 104) scale(1.05) rotate(4)" />
		</svg>

		<svg class="ds-jelly" viewBox="0 0 120 180" aria-hidden="true">
			<defs>
				<radialGradient id="ds-jelly-glow" cx="50%" cy="30%" r="68%">
					<stop offset="0%" stop-color="rgba(178, 240, 250, 0.6)" />
					<stop offset="58%" stop-color="rgba(116, 214, 232, 0.18)" />
					<stop offset="100%" stop-color="rgba(116, 214, 232, 0)" />
				</radialGradient>
			</defs>
			<path
				class="ds-jelly-bell"
				d="M12 74 C10 34 30 8 60 8 C90 8 110 34 108 74 C102 68 96 76 86 72 C76 68 70 76 60 72 C50 68 44 76 34 72 C24 68 18 76 12 74 Z"
				fill="url(#ds-jelly-glow)"
				stroke="rgba(150, 230, 245, 0.42)"
				stroke-width="1.2"
			/>
			<g
				class="ds-jelly-arms"
				fill="none"
				stroke="rgba(140, 225, 242, 0.4)"
				stroke-width="1.3"
				stroke-linecap="round"
			>
				<path d="M34 74 C28 100 40 118 32 150" />
				<path d="M46 76 C42 104 52 124 46 158" />
				<path d="M60 76 C60 108 56 130 60 162" />
				<path d="M74 76 C78 104 68 124 74 158" />
				<path d="M86 74 C92 100 80 118 88 150" />
			</g>
			<g
				class="ds-jelly-arms ds-jelly-arms--inner"
				fill="none"
				stroke="rgba(178, 236, 248, 0.5)"
				stroke-width="1.1"
				stroke-linecap="round"
			>
				<path d="M52 78 C50 96 54 108 52 124" />
				<path d="M68 78 C70 96 66 108 68 124" />
			</g>
		</svg>

		<svg class="ds-silhouette ds-leviathan" viewBox="0 0 600 200" aria-hidden="true">
			<path d="M16 118 C118 58 224 48 344 70 C424 86 504 98 584 120 C504 150 424 162 344 152 C224 172 118 152 16 118 Z" />
			<path d="M584 120 L600 82 L598 120 L600 158 Z" />
		</svg>

		<div class="ds-ruler">
			<div class="ds-ruler-track">
				{rulerTicks.map((tick) => (
					<div class:list={['ds-ruler-tick', { 'ds-ruler-tick--major': tick.major }]}>
						<span class="ds-ruler-label">{tick.label}</span>
					</div>
				))}
			</div>
		</div>

		{gauges.map((hud) => (
			<div class={`ds-hud ds-hud--${hud.tone}`}>
				{hud.rows.map((row) => (
					<p class="ds-hud-row">
						<span class="ds-hud-label">{row.label}</span>
						<span class="ds-hud-value" data-ds-hud={row.hook}>{row.value}</span>
					</p>
				))}
			</div>
		))}

		<div class="ds-core">
			<div class="ds-sonar">
				<span class="ds-sonar-ring"></span>
				<span class="ds-sonar-ring ds-sonar-ring--b"></span>
			</div>

			<div class="ds-spotlight"></div>
			<div class="ds-beam"></div>

			<div class="ds-readout">
				<p class="ds-label">DEPTH</p>
				<p class="ds-value" data-ds-depth>00000 m</p>
				<div class="ds-panel">
					<p class="ds-cell">
						<span class="ds-label ds-label--cell">PRESSURE</span>
						<span class="ds-cell-value" data-ds-pressure>1.0 BAR</span>
					</p>
					<p class="ds-cell">
						<span class="ds-label ds-label--cell">TEMP</span>
						<span class="ds-cell-value" data-ds-temp>18.0 °C</span>
					</p>
				</div>
			</div>

			<div class="ds-wordmark">
				<p class="ds-letters">
					{letters.map((letter) => <span>{letter}</span>)}
				</p>
				<p class="ds-tagline">BELOW THE SURFACE</p>
			</div>
		</div>

		<p class="ds-status">
			{statuses.map((status) => <span data-ds-for={status.key}>{status.text}</span>)}
		</p>

		<div class="ds-vignette"></div>
		<div class="ds-porthole">
			<span class="ds-rivet ds-rivet--tl"></span>
			<span class="ds-rivet ds-rivet--tr"></span>
			<span class="ds-rivet ds-rivet--bl"></span>
			<span class="ds-rivet ds-rivet--br"></span>
			<span class="ds-glass"></span>
			<span class="ds-droplet ds-droplet--a"></span>
			<span class="ds-droplet ds-droplet--b"></span>
		</div>
		<div class="ds-dial">
			<span class="ds-dial-ring"></span>
			<span class="ds-dial-sweep"></span>
			<span class="ds-dial-needle"></span>
		</div>
		<div class="ds-leds">
			<span class="ds-led ds-led--rec">REC</span>
			<span class="ds-led ds-led--link">LINK</span>
		</div>

		<div class="ds-grain"></div>
		<div class="ds-scanlines"></div>
	</div>

	<button class="ds-skip" type="button" data-ds-skip aria-label={copy.ui.intro.skip}>
		{copy.ui.intro.skip}
	</button>
</div>

<script>
	import { initDeepSeaIntro } from '../scripts/deep-sea-intro.ts';

	initDeepSeaIntro();
</script>
