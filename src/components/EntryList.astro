---
import RepoStars from './RepoStars.astro';

interface Entry {
	meta: string;
	title: string;
	excerpt: string;
	pill?: string;
	href?: string;
	external?: boolean;
	stars?: number;
	starsLabel?: string;
}

interface Props {
	entries: Entry[];
}

const { entries } = Astro.props;
---

<div class="feed">
	{
		entries.map((entry) => {
			const body = (
				<>
					<div class="entry-date">{entry.meta}</div>
					<div class="entry-main">
						<div class="entry-title">{entry.title}</div>
						<div class="entry-excerpt">{entry.excerpt}</div>
					</div>
					{entry.pill && <div class="entry-pillar">{entry.pill}</div>}
					{typeof entry.stars === 'number' && (
						<div class="entry-stars">
							<RepoStars stars={entry.stars} label={entry.starsLabel ?? String(entry.stars)} filled />
						</div>
					)}
				</>
			);
			return entry.href ? (
				<a
					class="entry"
					href={entry.href}
					target={entry.external ? '_blank' : undefined}
					rel={entry.external ? 'noreferrer' : undefined}
				>
					{body}
				</a>
			) : (
				<div class="entry entry-static">{body}</div>
			);
		})
	}
</div>

<style>
	.entry-static:hover .entry-title {
		text-decoration: none;
	}
	.entry-stars {
		padding-top: 5px;
	}
	@media (max-width: 680px) {
		.entry-stars {
			padding-top: 0;
		}
	}
</style>
