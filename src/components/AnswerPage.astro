---
import Icon from './Icon.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getPublicProfile } from '../lib/public-data';
import { getSiteCopy } from '../lib/site-copy';
import { localeFromPath, localizedHref } from '../lib/locale';

interface Props {
	entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const copy = getSiteCopy(locale);
const UI = copy.ui;
const { Content } = await render(entry);
const publicProfile = await getPublicProfile(locale);
const { question, shortAnswer, title } = entry.data;
---

<div class="wrap page page-article">
	<div class="crumbs">
		<a href={localizedHref(locale, '/')}>{UI.answers.homeCrumb}</a><span class="sep">/</span>
		<a href={localizedHref(locale, '/answers/')}>{UI.answers.label}</a><span class="sep">/</span>
		<span>{UI.answers.answerCrumb}</span>
	</div>

	<div class="prose article-heading">
		<h1 id="_top" class="display article-title">{question ?? title}</h1>
		{shortAnswer && <p class="lede answer-lede">{shortAnswer}</p>}
	</div>

	<hr class="rule-soft article-divider" />

	<div class="prose">
		<Content />
	</div>

	<div class="article-return answer-return">
		<a class="btn btn-ghost" href={localizedHref(locale, '/ask/')}>
			<Icon name="return" size={15} />
			{UI.answers.askAgain}
		</a>
		<a class="btn btn-ghost" href={localizedHref(locale, '/about/')}>
			{UI.answers.aboutPerson(publicProfile.name)}
		</a>
	</div>
</div>
