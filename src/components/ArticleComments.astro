---
import { siteConfig } from '../../site.config.mjs';
import { getSiteCopy } from '../lib/site-copy';
import { articleCommentPath } from '../lib/comments.mjs';
import { localeFromPath } from '../lib/locale';

interface Props {
	entryId: string;
}

const { entryId } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const copy = getSiteCopy(locale);
const UI = copy.ui;
const comments = siteConfig.comments;
---
<section
	class="article-comments"
	aria-labelledby="article-comments-heading"
	data-twikoo-comments
	data-env-id={comments.envId}
	data-path={articleCommentPath(entryId)}
	data-lang={locale}
	data-unavailable-label={UI.comments.unavailable}
>
	<div class="article-comments-heading">
		<div>
			<p class="mono article-comments-kicker">{UI.comments.meta}</p>
			<h2 id="article-comments-heading" class="section-title">{UI.comments.heading}</h2>
		</div>
	</div>
	<p class="article-comments-note">{UI.comments.note}</p>
	<div class="article-comments-frame">
		<p class="mono article-comments-status" data-twikoo-status aria-live="polite">
			{UI.comments.loading}
		</p>
		<div data-twikoo-mount></div>
	</div>
	<noscript>
		<p class="article-comments-noscript">{UI.comments.noScript}</p>
	</noscript>
</section>

<script>
	import { initTwikooComments } from '../scripts/twikoo-comments';

	document.querySelectorAll<HTMLElement>('[data-twikoo-comments]').forEach((root) => initTwikooComments(root));
</script>
